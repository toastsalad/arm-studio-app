  "end_gcode": {
    "label": "End Gcode",
    "description": "End Gcode description",
    "default_value": ";----------- End Gcode -------------\n;-----------------------------------",
    "type": "str"
  },
  "transformation": {
    "icon": "base64xxx",
    "label": "Transformation",
    "type": "category",
    "description": "Transformation B&W description",
    "children": {
      "img_width": {
        "default_value": 0
      },
      "img_height": {
        "default_value": 0
      },
      "width": {
        "label": "Width",
        "description": "Width description",
        "default_value": 5,
        "type": "int",
        "unit": "mm",
        "minimum_value": 5
      },
      "height": {
        "label": "Height",
        "description": "Height description",
        "default_value": 5,
        "type": "int",
        "unit": "mm",
        "minimum_value": 5
      },
      "rotation": {
        "label": "Rotation",
        "description": "Rotation description",
        "default_value": 0,
        "type": "int",
        "unit": "degree",
        "minimum_value": -180,
        "maximum_value": 180
      },
      "x": {
        "label": "Move X",
        "description": "Move X description",
        "default_value": 0,
        "type": "int",
        "unit": "mm",
        "minimum_value": -350,
        "maximum_value": 350
      },
      "y": {
        "label": "Move Y",
        "description": "Move Y description",
        "default_value": 300,
        "type": "int",
        "unit": "mm",
        "minimum_value": 0,
        "maximum_value": 700
      },
      "flip_model": {
        "label": "Flip Model",
        "description": "Flip Model description",
        "default_value": "None",
        "type": "enum",
        "options": {
          "None": "None",
          "Vertical": "Vertical",
          "Horizontal": "Horizontal",
          "Both": "Both"
        }
      }
    }
  },
  "config": {
    "icon": "base64xxx",
    "label": "Svg",
    "type": "category",
    "description": "Config of Vector",
    "children": {
      "optimize_path": {
        "label": "Optimize Path",
        "description": "Reorder strokes to cut pen-up travel (nearest-neighbour, reversing strokes when that shortens the move).",
        "default_value": false,
        "type": "bool"
      },
      "connect_outlines": {
        "label": "Connect Outline Ends",
        "description": "When optimizing, join stroke ends within 2 mm by drawing the short connector pen-down instead of lifting. Fewer pen lifts, but it leaves a mark where the artwork had a gap.",
        "default_value": false,
        "type": "bool"
      },
      "preserve_direction": {
        "label": "Preserve Stroke Direction",
        "description": "When optimizing, keep each stroke's point order. Needed for drag-knife cuts; leave off for pen and engraving so strokes can be reversed for shorter travel.",
        "default_value": false,
        "type": "bool"
      },
      "fill": {
        "default_value": false,
        "label": "Fill",
        "type": "bool",
        "description": "Fill description",
        "children": {
          "fill_density": {
            "label": "Fill Density",
            "description": "Fill Density description",
            "default_value": 4,
            "type": "int",
            "minimum_value": 1,
            "maximum_value": 50
          },
          "fill_style": {
            "label": "Fill Style",
            "description": "Hatch pattern: parallel, wave, concentric, spiral, hilbert, serpentine, fermat, moire, peano or engrave.",
            "default_value": "parallel",
            "type": "enum",
            "options": {
              "parallel": "Parallel",
              "wave": "Wave",
              "concentric": "Concentric",
              "spiral": "Spiral",
              "hilbert": "Hilbert",
              "serpentine": "Serpentine",
              "fermat": "Fermat",
              "moire": "Moire",
              "peano": "Peano",
              "engrave": "Engrave",
              "contourspiral": "Contour spiral",
              "hexlattice": "Hex lattice",
              "squarespiral": "Square spiral",
              "truchet": "Truchet",
              "gosper": "Gosper",
              "dragon": "Dragon"
            },
            "groups": [
              {
                "label": "Shape fills",
                "styles": ["parallel", "wave", "concentric", "contourspiral", "spiral", "squarespiral",
                            "serpentine", "fermat", "moire", "hexlattice", "engrave"]
              },
              {
                "label": "Curves",
                "styles": ["hilbert", "peano", "gosper", "dragon", "truchet"]
              }
            ]
          },
          "cross_hatch": {
            "label": "Cross Hatch",
            "description": "Add a second hatch pass at 90 degrees.",
            "default_value": false,
            "type": "bool"
          },
          "hatch_angle": {
            "label": "Hatch Angle",
            "description": "Angle of the hatch lines.",
            "default_value": 45,
            "type": "int",
            "unit": "deg",
            "minimum_value": 0,
            "maximum_value": 180
          },
          "inset": {
            "label": "Inset",
            "description": "Hold the hatch back from the outline.",
            "default_value": true,
            "type": "bool"
          },
          "inset_dist": {
            "label": "Inset Distance",
            "description": "How far the hatch is held back from the outline.",
            "default_value": 0.1,
            "type": "float",
            "unit": "mm",
            "minimum_value": 0,
            "maximum_value": 3
          },
          "connect_ends": {
            "label": "Connect Ends",
            "description": "Join nearby hatch ends with curves to reduce pen lifts.",
            "default_value": true,
            "type": "bool"
          },
          "hatch_scope": {
            "label": "Connect Scope",
            "description": "End-connection range, in hatch spacings.",
            "default_value": 3,
            "type": "int",
            "minimum_value": 0,
            "maximum_value": 10
          },
          "wave_amplitude": {
            "label": "Wave Amplitude",
            "description": "Sine wave amplitude (Wave fill style).",
            "default_value": 1,
            "type": "float",
            "unit": "mm",
            "minimum_value": 0,
            "maximum_value": 20
          },
          "wave_wavelength": {
            "label": "Wave Wavelength",
            "description": "Sine wave wavelength; 0 = 2x hatch spacing.",
            "default_value": 0,
            "type": "float",
            "unit": "mm",
            "minimum_value": 0,
            "maximum_value": 50
          },
          "jitter": {
            "label": "Hand-drawn Jitter",
            "description": "Add seeded random jitter for a hand-drawn look.",
            "default_value": false,
            "type": "bool"
          },
          "jitter_amount": {
            "label": "Jitter Amount",
            "description": "Jitter strength (standard deviation).",
            "default_value": 0.3,
            "type": "float",
            "unit": "mm",
            "minimum_value": 0,
            "maximum_value": 5
          }
        }
      },
      "group_by_color": {
        "label": "Group By Color",
        "description": "Draw all matching colors together and pause for pen swaps.",
        "default_value": false,
        "type": "bool"
      },
      "pause_between_colors": {
        "label": "Pause Between Colors",
        "description": "Insert a pause so you can change pens.",
        "default_value": false,
        "type": "bool"
      }
    }
  },
  "working_parameters": {
    "icon": "base64xxx",
    "label": "Working Parameters",
    "type": "category",
    "description": "Working Parameters description",
    "children": {
      "work_speed": {
        "label": "Work Speed",
        "description": "Determines how fast the front end moves when it’s working.",
        "placeholder": "#work_speed#",
        "default_value": 2000,
        "type": "int",
        "unit": "mm/min",
        "minimum_value": 1500,
        "maximum_value": 2500
      },
      "jog_speed": {
        "label": "Jog Speed",
        "description": "Determines how fast the front end moves when it’s not working.",
        "placeholder": "#jog_speed#",
        "default_value": 2000,
        "type": "int",
        "unit": "mm/min",
        "minimum_value": 1500,
        "maximum_value": 2500,
        "hidden": "movement_mode === greyscale-dot"
      },
      "dwell_time": {
        "label": "Dwell Time",
        "description": "Pause DexArm and wait before turning ON laser. It helps improve laser engraving quality.",
        "placeholder": "#dwell_time#",
        "default_value": 0,
        "type": "int",
        "unit": "ms",
        "minimum_value": 1,
        "maximum_value": 100,
        "hidden": "movement_mode === greyscale-line"
      },
      "engrave_time": {
        "label": "Engrave Time",
        "description": "Determines how long the laser keeps on when it's engraving a dot.",
        "placeholder": "#engrave_time#",
        "default_value": 5,
        "type": "int",
        "unit": "ms",
        "minimum_value": 1,
        "maximum_value": 100,
        "hidden": "movement_mode === greyscale-line"
      },
      "power": {
        "label": "Power",
        "description": "Power to use when laser is working.",
        "placeholder": "#power#",
        "default_value": 50,
        "type": "int",
        "unit": "%",
        "minimum_value": 1,
        "maximum_value": 100
      },
      "multi_pass": {
        "label": "Multi-Pass",
        "description": "When enabled, the Arm will run the G-code multiple times automatically according to the below settings. This feature helps you cut materials that can't be cut with only one pass.",
        "default_value": false,
        "type": "bool",
        "children": {
          "passes": {
            "label": "Passes",
            "description": "Determines how many times the printer will run the G-code automatically.",
            "default_value": 2,
            "type": "int",
            "minimum_value": 1,
            "maximum_value": 10
          },
          "pass_depth": {
            "label": "Pass Depth",
            "description": "Determines how much the laser module will be lowered after each pass.",
            "default_value": 1,
            "type": "int",
            "unit": "mm",
            "minimum_value": 1,
            "maximum_value": 5
          }
        }
      }
    }
  }
}
