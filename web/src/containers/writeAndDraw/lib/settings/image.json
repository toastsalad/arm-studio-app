    "config": {
        "icon": "base64xxx",
        "label": "Image",
        "type": "category",
        "description": "A picture shaded by its own tone. The fill decides where the ink goes.",
        "children": {
            "optimize_path": {
                "label": "Optimize Path",
                "description": "Reorder strokes to cut pen-up travel (nearest-neighbour, reversing strokes when that shortens the move).",
                "default_value": true,
                "type": "bool"
            },
            "fill": {
                "default_value": true,
                "label": "Fill",
                "type": "bool",
                "description": "Fill description",
                "children": {
                    "fill_density": {
                        "label": "Fill Density",
                        "description": "Fill Density description",
                        "default_value": 4,
                        "type": "int",
                        "minimum_value": 1,
                        "maximum_value": 50
                    },
                    "fill_style": {
                        "label": "Fill Style",
                        "description": "How the image is turned into ink: shade keeps the dark parts of a hatch grid, stipple scatters dots, scribble wanders.",
                        "default_value": "shade",
                        "type": "enum",
                        "options": {
                            "shade": "Shade",
                            "stipple": "Stipple",
                            "scribble": "Scribble"
                        },
                        "groups": [
                            {
                                "label": "Image shading",
                                "hint": "Reads the picture as a tone. Density sets the pitch: a coarse spacing gives a readable stipple and a looser scribble.",
                                "styles": [
                                    "shade",
                                    "stipple",
                                    "scribble"
                                ]
                            }
                        ]
                    },
                    "hatch_angle": {
                        "label": "Hatch Angle",
